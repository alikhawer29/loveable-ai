# Force browsers and shared caches to revalidate the SPA shell after each deploy.
# Hashed assets under assets/ can stay cached for a long time (new deploy = new filenames).
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Nginx: use something like (adjust the path prefix to match your deploy):
# location = /infinityfloral/index.html {
#   add_header Cache-Control "no-cache, no-store, must-revalidate" always;
# }
